{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx --no-install next dev -p 3000",
    "build": "npx --no-install next build",
    "start": "npx --no-install next start -p 3000",
    "lint": "npx --no-install next lint",
    "db:push": "npx -y prisma db push",
